# Copia este archivo a ".env" (en esta misma carpeta, deploy/) y rellena TODOS los valores.
#   cp .env.example .env && chmod 600 .env
# Nunca subas ".env" a Git ni lo pegues en un chat: contiene las claves de producción.
# Los valores "cambia-esto" son marcadores A PROPÓSITO inválidos: la API no arranca en producción
# hasta que los sustituyas por secretos reales (de 32 caracteres o más).
# Genera cada secreto con:   python3 -c "import secrets; print(secrets.token_urlsafe(32))"
# Guarda una copia de este archivo FUERA del servidor (gestor de contraseñas): sin N8N_ENCRYPTION_KEY
# no se pueden recuperar las credenciales guardadas en n8n.

# ---------------------------------------------------------------------------------------
# Dominio
# ---------------------------------------------------------------------------------------
# Dominio base. Hacen falta dos registros DNS de tipo A hacia el servidor:
#   api.<DOMAIN>   y   n8n.<DOMAIN>
DOMAIN=tu-empresa.com
# Correo al que Let's Encrypt avisa si un certificado va a caducar.
ACME_EMAIL=admin@tu-empresa.com
# Zona horaria de n8n (por ejemplo America/Lima, Europe/Madrid). Por defecto, UTC.
# TZ=UTC

# ---------------------------------------------------------------------------------------
# Base de datos (dos contraseñas distintas)
# ---------------------------------------------------------------------------------------
POSTGRES_PASSWORD=cambia-esto
N8N_DB_PASSWORD=cambia-esto-tambien

# ---------------------------------------------------------------------------------------
# API
# ---------------------------------------------------------------------------------------
# Dirección https desde la que se sirve la interfaz (la de Vercel), sin barra final.
CORS_ORIGINS=https://tu-proyecto.vercel.app
# Claves de las automatizaciones. Formato nombre:clave (32+ caracteres). La de "n8n" es la que se
# pone en la credencial "TaskFlow - clave de la API" de n8n.
API_KEYS=n8n:cambia-esto
# Inicio de sesión de las personas. El hash se genera EN TU ORDENADOR con:
#   python tools/hash_password.py
# y se pega entre COMILLAS SIMPLES (el hash contiene "$", que si no se interpretaría).
ADMIN_USERNAME=admin
ADMIN_PASSWORD_HASH='scrypt$cambia$esto'
# Firma los tokens de sesión (32+ caracteres). Si se cambia, todas las sesiones caducan.
AUTH_SECRET_KEY=cambia-esto
# Opcional: priorización con IA. Sin clave, esa función responde 503.
ANTHROPIC_API_KEY=

# ---------------------------------------------------------------------------------------
# n8n
# ---------------------------------------------------------------------------------------
# Mismo valor que la credencial "TaskFlow - secreto del webhook" de n8n (cabecera X-TaskFlow-Secret).
N8N_WEBHOOK_SECRET=cambia-esto
# Cifra las credenciales de n8n. NO la cambies después de usar n8n (dejarían de poder leerse).
N8N_ENCRYPTION_KEY=cambia-esto
