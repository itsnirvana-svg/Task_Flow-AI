# Copia este archivo a .env y completa los valores. Nunca subas .env al repositorio.

# Base de datos. Por defecto SQLite local (archivo taskflow.db).
# Para PostgreSQL: postgresql+psycopg://usuario:clave@localhost:5432/taskflow
DATABASE_URL=sqlite:///./taskflow.db

# Clave de la API de Anthropic (https://console.anthropic.com/)
ANTHROPIC_API_KEY=

# Modelo de Claude a utilizar
ANTHROPIC_MODEL=claude-sonnet-5-5

# Orígenes permitidos por CORS, separados por comas (frontends en desarrollo)
CORS_ORIGINS=http://localhost:5173,http://localhost:5500

# Automatización con n8n: webhook que recibe los eventos (task.created, task.completed...).
# Déjalo vacío para no enviar eventos.
N8N_WEBHOOK_URL=
# Secreto compartido; se envía en la cabecera X-TaskFlow-Secret y n8n debe verificarlo.
N8N_WEBHOOK_SECRET=

# Google Calendar (Google Cloud Console > Credenciales > ID de cliente OAuth)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8000/api/calendar/callback

# Clave para cifrar los refresh tokens en base de datos (Fernet, base64 de 32 bytes)
TOKEN_ENCRYPTION_KEY=
