# Copia este archivo a .env y completa los valores. Nunca subas .env al repositorio.
# Todas las variables de la aplicación están aquí; las comentadas muestran su valor por defecto.

# ---------------------------------------------------------------------------------------
# Entorno
# ---------------------------------------------------------------------------------------
# development (por defecto) o production. En producción la aplicación NO ARRANCA si alguna
# conexión apunta a un entorno de desarrollo o de prueba (SQLite, localhost, /webhook-test/,
# direcciones sin https, secreto del webhook ausente).
APP_ENV=development

# ---------------------------------------------------------------------------------------
# Base de datos
# ---------------------------------------------------------------------------------------
# Desarrollo: SQLite local (archivo taskflow.db en el directorio donde arranca la API).
DATABASE_URL=sqlite:///./taskflow.db
# Producción: PostgreSQL. Se aceptan los esquemas postgres:// y postgresql://.
# DATABASE_URL=postgresql://usuario:clave@servidor:5432/taskflow

# ---------------------------------------------------------------------------------------
# API de Anthropic (priorización con IA)
# ---------------------------------------------------------------------------------------
# Clave de https://console.anthropic.com/ ; sin ella, /api/ai/prioritize responde 503.
ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=claude-sonnet-5-5
# ANTHROPIC_TIMEOUT_SECONDS=30     tiempo máximo de espera a Claude por llamada
# AI_RATE_LIMIT_PER_MINUTE=10      llamadas a la IA por minuto y por cliente (cada una cuesta dinero)

# ---------------------------------------------------------------------------------------
# Autenticación de la API
# ---------------------------------------------------------------------------------------
# Todas las rutas /api/* exigen credenciales (solo /health y el inicio de sesión son públicos).
# Hay dos tipos; usa uno o los dos:
#
# 1) Claves de API, para servicios como n8n (cabecera X-API-Key). Una por cliente, así se puede
#    revocar una sin afectar a las demás. Formato: nombre:clave,otro:clave
#    Genera cada clave con:  python -c "import secrets; print(secrets.token_urlsafe(32))"
# API_KEYS=n8n:pega-aqui-una-clave-de-32-caracteres-o-mas
API_KEYS=
#
# 2) Inicio de sesión para personas (POST /api/auth/login devuelve un token que caduca).
#    El hash se genera con:  python tools/hash_password.py   (la contraseña no se guarda)
ADMIN_USERNAME=
ADMIN_PASSWORD_HASH=
#    Firma los tokens de sesión. Obligatoria si hay ADMIN_PASSWORD_HASH; en producción, 32+ caracteres.
AUTH_SECRET_KEY=
# AUTH_TOKEN_MINUTES=60            duración de un token de sesión
# LOGIN_MAX_ATTEMPTS_PER_MINUTE=5  intentos de inicio de sesión por minuto y por dirección IP
#
# Solo desarrollo: deja la API abierta, sin credenciales. En producción la aplicación NO ARRANCA
# con esto activado. Para trabajar con la API protegida, déjalo en false y define las credenciales.
AUTH_DISABLED=true

# ---------------------------------------------------------------------------------------
# CORS: dominios desde los que una página puede llamar a la API (separados por comas)
# ---------------------------------------------------------------------------------------
# Desarrollo: la interfaz servida en el puerto 5500.
CORS_ORIGINS=http://localhost:5500
# Producción: los dominios reales, con https.
# CORS_ORIGINS=https://tareas.tu-empresa.com

# ---------------------------------------------------------------------------------------
# n8n: webhook que recibe los eventos (task.created, task.completed...)
# ---------------------------------------------------------------------------------------
# Déjalo vacío para no enviar eventos. La ruta debe coincidir con el "Path" del nodo Webhook
# de tu flujo de n8n, y debe ser la de producción (/webhook/...), no la de pruebas
# (/webhook-test/..., que solo atiende una petición).
# El flujo del repositorio (n8n/workflows/taskflow-eventos.json) usa la ruta /webhook/taskflow;
# cómo importarlo y verificarlo: n8n/README.md.
N8N_WEBHOOK_URL=
# Producción: https://n8n.tu-empresa.com/webhook/taskflow
# Secreto compartido; se envía en la cabecera X-TaskFlow-Secret y n8n lo verifica (Header Auth).
# Debe ser el mismo valor que la credencial "TaskFlow - secreto del webhook" de n8n.
# Obligatorio si hay N8N_WEBHOOK_URL en producción.
N8N_WEBHOOK_SECRET=

# ---------------------------------------------------------------------------------------
# Entrega de eventos a n8n (opcionales; se muestran los valores por defecto)
# ---------------------------------------------------------------------------------------
# EVENTS_POLL_SECONDS=1.0          cada cuánto revisa el despachador si hay eventos pendientes
# EVENTS_MAX_ATTEMPTS=8            intentos antes de descartar un evento
# EVENTS_RETRY_BASE_SECONDS=5      espera inicial; se duplica en cada intento
# EVENTS_RETRY_MAX_SECONDS=900     espera máxima entre intentos
# EVENTS_LEASE_SECONDS=30          reserva de un evento mientras se envía (debe superar los 5 s de
#                                  envío); permite varios procesos de la API sin duplicados
# EVENTS_RETENTION_DAYS=7          días que se conservan los eventos ya enviados
